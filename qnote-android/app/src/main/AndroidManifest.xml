<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      allowBackup is deliberately off. Auto Backup would otherwise upload the
      whole note database to the user's Google Drive account with no way to
      opt out per-file, which sits badly with a note-taking app that already
      treats the Pebble pairing itself as sensitive (see PebbleRepository:
      auto-select is off there for the same reason). "Back up notes" in the
      overflow menu is the deliberate alternative: the user picks where the
      file goes and it round-trips through "Restore notes".
    -->
    <application
        android:name=".QNoteApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QNote">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QNote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Makes qnote a share target: "Share" on a snippet, a link, a
              selection of text in any app can land here. The phone is the
              archive, and text someone chose to share is already something
              they decided was worth keeping, which does not stop being true
              just because it did not come from a watch.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          The Pebble app binds this to hand over AppMessages and datalogging
          batches. It must be exported for that cross-process bind to work; the
          library authenticates the caller, and PebbleAndroidAppPicker pins
          which Pebble app we accept.
        -->
        <service
            android:name=".pebble.QNoteListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.rebble.pebblekit2.RECEIVE_DATA_FROM_WATCH" />
            </intent-filter>
        </service>
    </application>
</manifest>
